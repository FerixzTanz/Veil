<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- ① Title bar: back on the left, page name, the page's own actions on the right -->
    <LinearLayout
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/title_bar_height"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="@dimen/gutter">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/title_back"
            style="@style/Widget.Veil.IconButton"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
            android:contentDescription="@string/action_back"
            app:icon="@drawable/ic_back" />

        <TextView
            android:id="@+id/title_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Veil.Title" />

        <FrameLayout
            android:id="@+id/title_actions"
            android:layout_width="wrap_content"
            android:layout_height="match_parent" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/line"
        android:background="@color/line" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- ② Section list -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/section_list"
            android:layout_width="@dimen/list_width"
            android:layout_height="match_parent"
            android:background="@color/surface"
            android:clipToPadding="false"
            android:paddingStart="@dimen/gutter"
            android:paddingTop="@dimen/gutter"
            android:paddingEnd="@dimen/gutter" />

        <View
            android:layout_width="@dimen/line"
            android:layout_height="match_parent"
            android:background="@color/line" />

        <!-- ③ Content -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/section_content"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>
