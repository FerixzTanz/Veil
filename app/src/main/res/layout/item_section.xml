<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/section_row_height"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_section_row"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">

    <ImageView
        android:id="@+id/section_icon"
        android:layout_width="@dimen/section_icon_size"
        android:layout_height="@dimen/section_icon_size"
        android:importantForAccessibility="no"
        app:tint="@color/section_icon" />

    <TextView
        android:id="@+id/section_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Veil.Row" />
</LinearLayout>
