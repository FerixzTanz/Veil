<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingStart="@dimen/page_padding"
    android:paddingTop="@dimen/gutter"
    android:paddingEnd="@dimen/page_padding"
    android:paddingBottom="@dimen/page_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- What the test does, and the button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gutter"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/row_padding">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cluster_test_title"
                android:textAppearance="@style/TextAppearance.Veil.Body" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxWidth="760dp"
                android:text="@string/cluster_test_summary"
                android:textAppearance="@style/TextAppearance.Veil.Micro"
                android:textColor="@color/text_secondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gutter"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/cluster_ask_projection"
                        android:textAppearance="@style/TextAppearance.Veil.Body" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/cluster_ask_projection_summary"
                        android:textAppearance="@style/TextAppearance.Veil.Micro"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/cluster_ask_projection"
                    style="@style/Widget.Veil.Switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/row_padding" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cluster_run"
                style="@style/Widget.Veil.PrimaryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gutter"
                android:minWidth="200dp"
                android:text="@string/cluster_run" />
        </LinearLayout>

        <!-- The last result -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gutter"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/row_padding">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cluster_result_title"
                android:textAppearance="@style/TextAppearance.Veil.Body" />

            <TextView
                android:id="@+id/cluster_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gutter"
                android:maxWidth="760dp"
                android:textAppearance="@style/TextAppearance.Veil.Caption"
                android:textColor="@color/text_secondary"
                android:textIsSelectable="true" />
        </LinearLayout>

        <!-- The safety note -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gutter"
            android:maxWidth="760dp"
            android:text="@string/cluster_safety"
            android:textAppearance="@style/TextAppearance.Veil.Micro"
            android:textColor="@color/text_secondary" />

        <!-- The log -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gutter"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/row_padding">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cluster_log_title"
                android:textAppearance="@style/TextAppearance.Veil.Body" />

            <TextView
                android:id="@+id/cluster_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gutter"
                android:fontFamily="monospace"
                android:textAppearance="@style/TextAppearance.Veil.Micro"
                android:textColor="@color/text_secondary"
                android:textIsSelectable="true" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
