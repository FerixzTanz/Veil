<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingStart="@dimen/page_padding"
    android:paddingTop="@dimen/gutter"
    android:paddingEnd="@dimen/page_padding"
    android:paddingBottom="@dimen/page_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gutter"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/row_padding">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/net_receiver_title"
                android:textAppearance="@style/TextAppearance.Veil.Body" />

            <TextView
                android:id="@+id/net_receiver"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gutter"
                android:fontFeatureSettings="tnum"
                android:textAppearance="@style/TextAppearance.Veil.Caption"
                android:textColor="@color/text_secondary"
                android:textIsSelectable="true" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gutter"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/row_padding">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/net_advice_title"
                android:textAppearance="@style/TextAppearance.Veil.Body" />

            <TextView
                android:id="@+id/net_advice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gutter"
                android:maxWidth="760dp"
                android:textAppearance="@style/TextAppearance.Veil.Caption"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gutter"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/row_padding">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/net_networks_title"
                android:textAppearance="@style/TextAppearance.Veil.Body" />

            <TextView
                android:id="@+id/net_networks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gutter"
                android:fontFeatureSettings="tnum"
                android:textAppearance="@style/TextAppearance.Veil.Caption"
                android:textColor="@color/text_secondary"
                android:textIsSelectable="true" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gutter"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/row_padding">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/net_export_title"
                android:textAppearance="@style/TextAppearance.Veil.Body" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gutter"
                android:maxWidth="760dp"
                android:text="@string/net_export_summary"
                android:textAppearance="@style/TextAppearance.Veil.Caption"
                android:textColor="@color/text_secondary" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gutter"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/net_export_send"
                    style="@style/Widget.Veil.PrimaryButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/net_export_send" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/net_export_save"
                    style="@style/Widget.Veil.SecondaryButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gutter"
                    android:text="@string/net_export_save" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gutter"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/row_padding">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/net_log_title"
                android:textAppearance="@style/TextAppearance.Veil.Body" />

            <TextView
                android:id="@+id/net_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gutter"
                android:fontFamily="monospace"
                android:textAppearance="@style/TextAppearance.Veil.Micro"
                android:textColor="@color/text_secondary"
                android:textIsSelectable="true" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
