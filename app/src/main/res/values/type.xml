<?xml version="1.0" encoding="utf-8"?>
<!--
  Six text sizes, one per role. Layouts set android:textAppearance and never a
  literal size (TypeScaleTest holds that). The head-unit screen is read from an
  arm's length, so the smallest size is 14sp.
-->
<resources>
    <dimen name="text_micro">14sp</dimen>
    <dimen name="text_caption">16sp</dimen>
    <dimen name="text_body">18sp</dimen>
    <dimen name="text_row">21sp</dimen>
    <dimen name="text_title">26sp</dimen>
    <dimen name="text_display">28sp</dimen>

    <style name="TextAppearance.Veil" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.03</item>
    </style>

    <!-- Badges and counts -->
    <style name="TextAppearance.Veil.Micro">
        <item name="android:textSize">@dimen/text_micro</item>
    </style>

    <!-- Explanations, status lines -->
    <style name="TextAppearance.Veil.Caption">
        <item name="android:textSize">@dimen/text_caption</item>
    </style>

    <!-- Body text, button labels -->
    <style name="TextAppearance.Veil.Body">
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <!-- Row titles, section names, dialog body -->
    <style name="TextAppearance.Veil.Row">
        <item name="android:textSize">@dimen/text_row</item>
    </style>

    <!-- Page titles, dialog titles -->
    <style name="TextAppearance.Veil.Title">
        <item name="android:textSize">@dimen/text_title</item>
    </style>

    <!-- Numbers read from a metre away -->
    <style name="TextAppearance.Veil.Display">
        <item name="android:textSize">@dimen/text_display</item>
    </style>
</resources>
