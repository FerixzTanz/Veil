<?xml version="1.0" encoding="utf-8"?>
<!--
  One theme for day and night: every colour is a semantic name that
  values/ and values-night/ each give a value. Neutral greys, flat, orange accent.
-->
<resources>
    <style name="Base.Theme.Veil" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="materialAlertDialogTheme">@style/Theme.Veil.MaterialAlertDialog</item>

        <item name="colorPrimary">@color/energy</item>
        <item name="colorOnPrimary">@color/on_energy</item>
        <item name="colorPrimaryContainer">@color/energy_quiet</item>
        <item name="colorOnPrimaryContainer">@color/energy_text</item>
        <item name="colorSecondary">@color/text_secondary</item>
        <item name="colorOnSecondary">@color/surface</item>
        <item name="colorSecondaryContainer">@color/sunken</item>
        <item name="colorOnSecondaryContainer">@color/text_primary</item>
        <item name="colorError">@color/danger</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/sunken</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/sunken</item>
        <item name="colorSurfaceContainerHighest">@color/sunken</item>
        <item name="colorOutline">@color/line</item>
        <item name="elevationOverlayEnabled">false</item>
        <item name="elevationOverlayColor">@color/surface</item>
        <item name="switchStyle">@style/Widget.Veil.Switch</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
    </style>

    <style name="Theme.Veil" parent="Base.Theme.Veil" />

    <!-- Switch: the thumb is always white, the track turns orange when on. -->
    <style name="Widget.Veil.Switch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="android:thumb">@drawable/switch_thumb</item>
        <item name="track">@drawable/switch_track</item>
        <item name="switchMinWidth">56dp</item>
        <item name="android:background">@null</item>
    </style>

    <!-- Icon-only button in the title bar -->
    <style name="Widget.Veil.IconButton" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/sunken</item>
        <item name="iconTint">@color/text_primary</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">26dp</item>
        <item name="cornerRadius">@dimen/corner_radius</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingRight">0dp</item>
        <item name="rippleColor">@color/ripple</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- Solid primary button: orange fill, white label -->
    <style name="Widget.Veil.PrimaryButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/energy</item>
        <item name="android:textColor">@color/on_energy</item>
        <item name="android:textAppearance">@style/TextAppearance.Veil.Body</item>
        <item name="cornerRadius">@dimen/corner_radius</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="rippleColor">@color/ripple</item>
        <item name="elevation">0dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Secondary button: grey block -->
    <style name="Widget.Veil.SecondaryButton" parent="Widget.Veil.PrimaryButton">
        <item name="backgroundTint">@color/sunken</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Dialogs: neutral surface, no orange tint on the background. -->
    <style name="Theme.Veil.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorPrimary">@color/energy_text</item>
        <item name="elevationOverlayEnabled">false</item>
        <item name="elevationOverlayColor">@color/surface</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface</item>
        <item name="colorSurfaceContainerHighest">@color/surface</item>
        <item name="materialAlertDialogTitleTextStyle">@style/MaterialAlertDialog.Veil.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/MaterialAlertDialog.Veil.Body</item>
    </style>

    <style name="MaterialAlertDialog.Veil.Title" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="MaterialAlertDialog.Veil.Body" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textSize">@dimen/text_row</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
</resources>
